# =============================================================================
# Nexara — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env
#   openssl rand -hex 32    # Generate a SECRET_KEY
#   openssl rand -hex 16    # Generate a POSTGRES_PASSWORD
# =============================================================================

# === Required ================================================================

# Random secret for session signing and JWT tokens (min 32 hex chars).
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Password for the PostgreSQL database.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# === Network =================================================================

# Port exposed on the host for HTTP traffic.
# Put your reverse proxy (NPM, Caddy, Traefik) in front for HTTPS.
HTTP_PORT=8080

# Port for Prometheus metrics scraping.
METRICS_PORT=9090

# Comma-separated list of allowed CORS origins.
# Example: https://nexara.yourdomain.com
ALLOWED_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === Storage =================================================================

# Storage backend: "local" (default) or "s3" (any S3-compatible service).
STORAGE_BACKEND=local

# S3 settings (only needed when STORAGE_BACKEND=s3).
# Works with AWS S3, Garage, MinIO, Backblaze B2, Cloudflare R2, Wasabi.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nexara

# === Email (optional) ========================================================

# SMTP server for email notifications (invite emails, password resets).
# Leave blank to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Transcoding (optional) ==================================================

# GPU hardware acceleration for video transcoding.
# Values: none (CPU, default) | nvidia | vaapi (Intel/AMD)
# Also uncomment the matching device/deploy block in docker-compose.yml.
TRANSCODE_HW_ACCEL=none

# === OIDC / SSO (optional) ===================================================

# OpenID Connect provider for single sign-on.
# Leave blank to use built-in username/password authentication.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# === Registration ============================================================

# Allow new user registration (true/false).
ENABLE_REGISTRATION=true

# Require an invite code to register (true/false).
REQUIRE_INVITE=false
