# =============================================================================
# Nexara — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env
#   openssl rand -hex 32    # Generate a SECRET_KEY
#   openssl rand -hex 16    # Generate a POSTGRES_PASSWORD
# =============================================================================

# === Required ================================================================

# Random secret for session signing and JWT tokens (min 32 hex chars).
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Fernet key encrypting users' Apprise notification URLs at rest. Required
# for the Apprise channel; without it every delivery logs notif.channel.failed.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APPRISE_ENCRYPTION_KEY=

# Password for the PostgreSQL database.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# === Network =================================================================

# Port exposed on the host for HTTP traffic.
# Put your reverse proxy (NPM, Caddy, Traefik) in front for HTTPS.
HTTP_PORT=8080

# Port for Prometheus metrics scraping.
METRICS_PORT=9090

# Comma-separated list of allowed CORS origins.
# Example: https://nexara.yourdomain.com
ALLOWED_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === Storage =================================================================

# Storage backend: "local" (default) or "s3" (any S3-compatible service).
STORAGE_BACKEND=local

# S3 settings (only needed when STORAGE_BACKEND=s3).
# Works with AWS S3, Garage, MinIO, Backblaze B2, Cloudflare R2, Wasabi.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nexara

# === Email (optional) ========================================================

# SMTP server for email notifications (invite emails, password resets).
# Leave blank to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Transcoding (optional) ==================================================

# GPU hardware acceleration for video transcoding.
# Values: none (CPU, default) | nvidia | vaapi (Intel/AMD)
# Also uncomment the matching device/deploy block in docker-compose.yml.
TRANSCODE_HW_ACCEL=none

# === OIDC / SSO (optional) ===================================================

# Configure a default OAuth2/OIDC provider via environment variables.
# This seeds a provider on first startup that can be edited in the admin UI.
# Additional providers can be added via the admin panel (Settings > SSO Providers).
#
# For Authentik: OIDC_ISSUER=https://auth.yourdomain.com/application/o/nexara
# For Keycloak:  OIDC_ISSUER=https://auth.yourdomain.com/realms/nexara
# For Google:    Use the admin UI (Google requires manual endpoint config)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Group names from your IdP that map to Nexara roles.
# Users in OIDC_ADMIN_GROUP get admin role, OIDC_MEMBER_GROUP get member role.
# Users in neither group get member role by default.
OIDC_ADMIN_GROUP=nexara-admin
OIDC_MEMBER_GROUP=nexara-member

# OAuth2 scopes to request. Most OIDC providers need "openid profile email".
# Add "groups" if your provider supports group claims.
OIDC_SCOPES=openid profile email groups

# === Registration ============================================================

# Allow new user registration (true/false).
ENABLE_REGISTRATION=true

# Require an invite code to register (true/false).
REQUIRE_INVITE=false
